{
  "name": "qa-bench",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "eval": "tsx src/eval.ts",
    "start-fixture": "tsx src/start.ts",
    "stop-fixture": "tsx src/stop.ts",
    "merge": "tsx src/merge.ts",
    "build-template": "tsx src/build-template.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@e2b/code-interpreter": "2.7.0",
    "@openai/codex": "0.160.0",
    "@openai/codex-sdk": "0.156.0",
    "@playwright/mcp": "0.0.82",
    "csv-parser": "3.2.1",
    "markdown-table": "3.0.4",
    "proper-lockfile": "4.1.2",
    "tsx": "4.19.1",
    "zod": "4.4.3",
    "@anthropic-ai/claude-code": "2.1.300",
    "agent-browser": "0.40.0"
  },
  "devDependencies": {
    "@types/node": "22.19.20",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "@trivago/prettier-plugin-sort-imports": "5.2.2"
  }
